# Copy to .env for local development. Never commit .env.
# This repository does not include cloud credentials, account ids, or a model id.

# Answer model. ollama runs on this machine. bedrock uses an AWS account you supply.
CODECOMPASS_LLM_BACKEND=ollama
CODECOMPASS_OLLAMA_URL=http://127.0.0.1:11434
CODECOMPASS_OLLAMA_MODEL=qwen2.5-coder:3b

# Optional hosted model. Fill these only in .env, using an account you are allowed to use.
# CODECOMPASS_LLM_BACKEND=bedrock
# CODECOMPASS_BEDROCK_MODEL_ID=
# CODECOMPASS_BEDROCK_REGION=us-east-1
# CODECOMPASS_BEDROCK_MAX_TOKENS=1024
# CODECOMPASS_BEDROCK_TEMPERATURE=0
# CODECOMPASS_BEDROCK_TIMEOUT_SECONDS=60
# Optional guardrail. Both values are required before one is attached.
# CODECOMPASS_BEDROCK_GUARDRAIL_IDENTIFIER=
# CODECOMPASS_BEDROCK_GUARDRAIL_VERSION=
# AWS credentials come from the standard AWS SDK chain (AWS_PROFILE, SSO, or env vars).

# Retrieval. disabled keeps the demo on SQLite full text and skips Qdrant.
CODECOMPASS_VECTOR_BACKEND=disabled
CODECOMPASS_EMBEDDING_BACKEND=fake
CODECOMPASS_EMBEDDING_DIMENSIONS=32

# Optional dense retrieval. Start Qdrant and keep dimensions aligned with the model.
# CODECOMPASS_VECTOR_BACKEND=qdrant
# CODECOMPASS_QDRANT_URL=http://127.0.0.1:6333
# CODECOMPASS_EMBEDDING_BACKEND=sentence_transformers
# CODECOMPASS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CODECOMPASS_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# CODECOMPASS_EMBEDDING_DIMENSIONS=384

CODECOMPASS_DATABASE_URL=sqlite+aiosqlite:///./data/codecompass.db
CODECOMPASS_UPLOAD_MAX_BYTES=52428800
CODECOMPASS_EXPANDED_MAX_BYTES=209715200
